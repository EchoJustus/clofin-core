root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{clj,cljc,cljs,edn}]
indent_size = 2

[*.{md,markdown}]
indent_size = 2
trim_trailing_whitespace = false

[*.{yaml,yml,json}]
indent_size = 2

[*.sql]
indent_size = 2

[Makefile]
indent_style = tab
