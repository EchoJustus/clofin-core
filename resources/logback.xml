<?xml version="1.0" encoding="UTF-8"?>
<!--
  CloFin logging.

  One line per event on stdout, which is what a container orchestrator expects.
  Request logging deliberately omits query strings and bodies: in a payments
  system those routinely carry account identifiers and counterparty names.
-->
<configuration scan="false">

  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX, UTC} %-5level [%thread] %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

  <!-- Third-party libraries are quiet unless something is wrong. -->
  <logger name="org.eclipse.jetty" level="WARN"/>
  <logger name="com.zaxxer.hikari" level="WARN"/>

  <root level="INFO">
    <appender-ref ref="STDOUT"/>
  </root>

</configuration>
