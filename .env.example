# CloFin — example environment configuration.
#
# Copy to `.env` and adjust for your machine. `.env` is git-ignored.
# All values below are synthetic local-development defaults. CloFin never
# connects to a real financial institution and never processes real funds.

# ---------------------------------------------------------------------------
# HTTP transport
# ---------------------------------------------------------------------------
CLOFIN_HTTP_HOST=0.0.0.0
CLOFIN_HTTP_PORT=8080

# ---------------------------------------------------------------------------
# PostgreSQL — system of record
# ---------------------------------------------------------------------------
POSTGRES_DB=clofin
POSTGRES_USER=clofin
POSTGRES_PASSWORD=clofin_local_dev_only
POSTGRES_PORT=5432

# JDBC URL used by the service. When running the service inside docker compose
# the host is `postgres`; when running it on the host against a composed
# database the host is `localhost`.
CLOFIN_DB_URL=jdbc:postgresql://localhost:5432/clofin
CLOFIN_DB_USER=clofin
CLOFIN_DB_PASSWORD=clofin_local_dev_only
CLOFIN_DB_POOL_SIZE=8

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# dev | test | prod — affects logging verbosity and error detail exposure.
CLOFIN_ENV=dev

# Run database migrations automatically on start-up.
CLOFIN_MIGRATE_ON_START=true

# ---------------------------------------------------------------------------
# Browser clients — a CORS allowlist, closed by default
# ---------------------------------------------------------------------------
# Comma-separated origins allowed to read this instance's responses from a
# browser page. **Leave it empty unless you are driving this instance from a
# browser.** Empty means the service sends no CORS header at all and refuses
# preflights, which is how CloFin behaved before this setting existed.
#
# Each entry is a full origin — scheme://host with an optional :port, no path
# and no trailing slash. There is no wildcard: `*` is refused at start-up
# rather than honoured or quietly dropped. See
# docs/ADR/0027-browser-clients-cors-allowlist-and-instance-self-identification.md
#
# Example, for the operator cockpit published on GitHub Pages plus a cockpit
# served locally during development:
#   CLOFIN_CORS_ALLOWED_ORIGINS=https://echojustus.github.io,http://localhost:4173
CLOFIN_CORS_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Self-identification
# ---------------------------------------------------------------------------
# The commit `GET /` reports. `make up` stamps this from your checkout, so you
# do not normally set it here. A value that is not a 40-character lower-case
# hex commit id is ignored — never reported — and an unresolvable commit is
# reported as the literal string "unknown". Self-reported, not attested.
# CLOFIN_SOURCE_COMMIT=
