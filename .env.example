# CloFin — example environment configuration.
#
# Copy to `.env` and adjust for your machine. `.env` is git-ignored.
# All values below are synthetic local-development defaults. CloFin never
# connects to a real financial institution and never processes real funds.

# ---------------------------------------------------------------------------
# HTTP transport
# ---------------------------------------------------------------------------
CLOFIN_HTTP_HOST=0.0.0.0
CLOFIN_HTTP_PORT=8080

# ---------------------------------------------------------------------------
# PostgreSQL — system of record
# ---------------------------------------------------------------------------
POSTGRES_DB=clofin
POSTGRES_USER=clofin
POSTGRES_PASSWORD=clofin_local_dev_only
POSTGRES_PORT=5432

# JDBC URL used by the service. When running the service inside docker compose
# the host is `postgres`; when running it on the host against a composed
# database the host is `localhost`.
CLOFIN_DB_URL=jdbc:postgresql://localhost:5432/clofin
CLOFIN_DB_USER=clofin
CLOFIN_DB_PASSWORD=clofin_local_dev_only
CLOFIN_DB_POOL_SIZE=8

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# dev | test | prod — affects logging verbosity and error detail exposure.
CLOFIN_ENV=dev

# Run database migrations automatically on start-up.
CLOFIN_MIGRATE_ON_START=true
